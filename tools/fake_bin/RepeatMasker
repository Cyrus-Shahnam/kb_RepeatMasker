#!/usr/bin/env python3
"""
FAKE RepeatMasker for dry-running the kb_repeatmasker Runner outside Docker
(lessons §8).  Same CLI shape, output names and file formats as RepeatMasker
4.2.4, but repeats are found by exact 13-mer matching to the library and a regex
for microsatellites.  It also enforces the real tool's 50-character ID limit.
NEVER used in the image.
"""
import gzip
import os
import re
import sys

VALUE_OPTS = {"-engine", "-e", "-pa", "-parallel", "-dir", "-lib", "-species", "-div",
              "-cutoff", "-frag", "-gc"}
K = 13
COMP = str.maketrans("ACGT", "TGCA")


def read_fasta(path):
    recs, sid, buf = [], None, []
    for line in open(path):
        line = line.rstrip("\n")
        if line.startswith(">"):
            if sid is not None:
                recs.append((sid, "".join(buf)))
            sid, buf = line[1:].split()[0], []
        else:
            buf.append(line.strip())
    if sid is not None:
        recs.append((sid, "".join(buf)))
    return recs


def main(argv):
    print("RepeatMasker version 4.2.4")
    if argv and argv[0] == "-v":
        return 0
    opts, flags, i = {}, set(), 0
    while i < len(argv) - 1:
        a = argv[i]
        if a in VALUE_OPTS:
            opts[a] = argv[i + 1]
            i += 2
        else:
            flags.add(a)
            i += 1
    query = argv[-1]
    if " " in query or not os.path.isabs(query):
        print("FAKE: query path must be absolute without spaces: %s" % query)
        return 1
    out_dir = opts.get("-dir", os.path.dirname(query))
    os.makedirs(out_dir, exist_ok=True)
    recs = read_fasta(query)
    for sid, _ in recs:
        if len(sid) > 50:
            print("FastaDB: sequence identifier longer than 50 characters: %s" % sid)
            return 2
    lib = []
    if "-lib" in opts:
        lib = read_fasta(opts["-lib"])
    elif "-species" in opts:
        sp = opts["-species"].lower()
        if sp not in ("drosophila melanogaster", "fakeus testus"):
            print("Species \"%s\" is not known to RepeatMasker." % opts["-species"])
            return 1
        if os.environ.get("FAKE_SPECIES_LIB"):
            lib = read_fasta(os.environ["FAKE_SPECIES_LIB"])
    else:
        print("FAKE: need -lib or -species")
        return 1

    index = {}
    for name, seq in lib:
        s = seq.upper()
        for strand, t in (("+", s), ("C", s.translate(COMP)[::-1])):
            for j in range(len(t) - K + 1):
                index.setdefault(t[j:j + K], (name, strand))
    base = os.path.join(out_dir, os.path.basename(query))
    rows = []
    masked_recs = []
    for sid, seq in recs:
        u = seq.upper()
        mask = bytearray(len(u))
        anns = []
        if "-noint" not in flags and index:
            hits = []
            for j in range(len(u) - K + 1):
                h = index.get(u[j:j + K])
                if h:
                    hits.append((j, h))
            cur = None
            for j, h in hits:
                if cur and j <= cur[1] + 60:
                    cur[1] = j + K
                    cur[2][h] = cur[2].get(h, 0) + 1
                else:
                    if cur:
                        anns.append(cur)
                    cur = [j, j + K, {h: 1}]
            if cur:
                anns.append(cur)
            anns = [a for a in anns if a[1] - a[0] >= 60]
        ann_rows = []
        for b, e, votes in anns:
            (name, strand) = max(votes.items(), key=lambda kv: kv[1])[0]
            rep, _, cls = name.partition("#")
            ann_rows.append((b, e, rep, cls or "Unknown", strand))
        if "-nolow" not in flags:
            for mt in re.finditer(r"(([ACGT]{1,6}?)\2{7,})", u):
                ann_rows.append((mt.start(), mt.end(), "(%s)n" % mt.group(2),
                                 "Simple_repeat", "+"))
        for b, e, rep, cls, strand in sorted(ann_rows):
            for j in range(b, e):
                mask[j] = 1
            rows.append((sid, b + 1, e, len(u) - e, strand, rep, cls))
        if "-xsmall" in flags:
            ms = "".join(c.lower() if mask[j] else c for j, c in enumerate(u))
        else:
            ch = "X" if "-x" in flags else "N"
            ms = "".join(ch if mask[j] else c for j, c in enumerate(u))
        masked_recs.append((sid, ms))

    if not rows:
        print("No repetitive sequences were detected in %s" % query)
        with open(base + ".out", "w") as fh:
            fh.write("There were no repetitive sequences detected in %s\n" % query)
        return 0
    with open(base + ".out", "w") as fh:
        fh.write("   SW   perc perc perc  query      position in query           "
                 "matching       repeat              position in  repeat\n"
                 "score   div. del. ins.  sequence    begin     end    (left)    "
                 "repeat         class/family         begin  end (left)   ID\n\n")
        for n, (sid, b, e, left, strand, rep, cls) in enumerate(rows, 1):
            fh.write("%6d %5.1f %4.1f %4.1f  %-10s %8d %8d %10s %s  %-14s %-18s "
                     "%6s %5d %5s %6d\n" % (300 + (e - b), 5.0, 0.5, 0.5, sid, b, e,
                                           "(%d)" % left, strand, rep, cls, "1",
                                           e - b + 1, "(0)", n))
    total = sum(len(s) for _, s in recs)
    masked_bp = sum(sum(1 for c in s if c.islower() or c in "NX") for _, s in masked_recs)
    with open(base + ".tbl", "w") as fh:
        fh.write("==================================================\n"
                 "file name: %s\nsequences:          %d\ntotal length:    %d bp\n"
                 "GC level:         42.00 %%\nbases masked:    %d bp ( %.2f %%)\n"
                 "==================================================\n"
                 % (os.path.basename(query), len(recs), total, masked_bp,
                    100.0 * masked_bp / total))
    with open(base + ".masked", "w") as fh:
        for sid, s in masked_recs:
            fh.write(">%s\n" % sid)
            for j in range(0, len(s), 60):
                fh.write(s[j:j + 60] + "\n")
    with gzip.open(base + ".cat.gz", "wt") as fh:
        fh.write("## FAKE cat file\n")
    if "-gff" in flags:
        with open(base + ".out.gff", "w") as fh:  # real 4.2.4 name
            fh.write("##gff-version 2\n##date 2026-10-20\n")
            for sid, b, e, _l, strand, rep, cls in rows:
                fh.write("%s\tRepeatMasker\tsimilarity\t%d\t%d\t5.0\t%s\t.\t"
                         "Target \"Motif:%s\" 1 %d\n"
                         % (sid, b, e, "+" if strand == "+" else "-", rep, e - b + 1))
    if "-a" in flags:
        open(base + ".align", "w").write("FAKE alignments\n")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

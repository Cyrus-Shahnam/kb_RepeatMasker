{
    "ver": "0.1.0",
    "authors": [
        "ac.shahnam"
    ],
    "contact": "https://www.kbase.us/support/",
    "categories": [
        "active",
        "annotation",
        "assembly"
    ],
    "widgets": {
        "input": null,
        "output": "no-display"
    },
    "parameters": [
        {
            "id": "assembly_refs",
            "optional": false,
            "advanced": false,
            "allow_multiple": true,
            "default_values": [
                ""
            ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [
                    "KBaseGenomeAnnotations.Assembly",
                    "KBaseGenomes.ContigSet"
                ]
            }
        },
        {
            "id": "species",
            "optional": true,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "text",
            "text_options": {}
        },
        {
            "id": "custom_library_ref",
            "optional": true,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "text",
            "text_options": {
                "valid_ws_types": [
                    "KBaseGenomeAnnotations.Assembly",
                    "KBaseGenomes.ContigSet"
                ]
            }
        },
        {
            "id": "mask_type",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [
                "soft"
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "soft",
                        "display": "Soft-mask: repeats in lowercase (for gene prediction)"
                    },
                    {
                        "value": "hard_N",
                        "display": "Hard-mask: repeats replaced by N"
                    },
                    {
                        "value": "hard_X",
                        "display": "Hard-mask: repeats replaced by X"
                    }
                ]
            }
        },
        {
            "id": "output_suffix",
            "optional": false,
            "advanced": false,
            "allow_multiple": false,
            "default_values": [
                "_masked"
            ],
            "field_type": "text",
            "text_options": {}
        },
        {
            "id": "save_masked_assembly",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "1"
            ],
            "field_type": "checkbox",
            "checkbox_options": {
                "checked_value": 1,
                "unchecked_value": 0
            }
        },
        {
            "id": "mask_scope",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "all"
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "all",
                        "display": "Interspersed repeats + simple repeats/low complexity"
                    },
                    {
                        "value": "interspersed_only",
                        "display": "Interspersed repeats only (-nolow)"
                    },
                    {
                        "value": "simple_only",
                        "display": "Simple repeats/low complexity only (-noint)"
                    }
                ]
            }
        },
        {
            "id": "speed",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "default"
            ],
            "field_type": "dropdown",
            "dropdown_options": {
                "options": [
                    {
                        "value": "default",
                        "display": "Default"
                    },
                    {
                        "value": "quick",
                        "display": "Quick (-q): 5-10% less sensitive, faster"
                    },
                    {
                        "value": "rush",
                        "display": "Rush (-qq): about 10% less sensitive, fastest"
                    },
                    {
                        "value": "slow",
                        "display": "Slow (-s): 0-5% more sensitive, 2-3x slower"
                    }
                ]
            }
        },
        {
            "id": "uncurated",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "0"
            ],
            "field_type": "checkbox",
            "checkbox_options": {
                "checked_value": 1,
                "unchecked_value": 0
            }
        },
        {
            "id": "norna",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "0"
            ],
            "field_type": "checkbox",
            "checkbox_options": {
                "checked_value": 1,
                "unchecked_value": 0
            }
        },
        {
            "id": "div",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                ""
            ],
            "field_type": "text",
            "text_options": {
                "validate_as": "float",
                "min_float": 0.1,
                "max_float": 99.9
            }
        },
        {
            "id": "cutoff",
            "optional": true,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "225"
            ],
            "field_type": "text",
            "text_options": {
                "validate_as": "int",
                "min_int": 100,
                "max_int": 2000
            }
        },
        {
            "id": "alignments",
            "optional": false,
            "advanced": true,
            "allow_multiple": false,
            "default_values": [
                "0"
            ],
            "field_type": "checkbox",
            "checkbox_options": {
                "checked_value": 1,
                "unchecked_value": 0
            }
        }
    ],
    "behavior": {
        "service-mapping": {
            "url": "",
            "name": "kb_repeatmasker",
            "method": "run_repeatmasker",
            "input_mapping": [
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                },
                {
                    "input_parameter": "assembly_refs",
                    "target_property": "assembly_refs",
                    "target_type_transform": "list<ref>"
                },
                {
                    "input_parameter": "species",
                    "target_property": "species"
                },
                {
                    "input_parameter": "custom_library_ref",
                    "target_property": "custom_library_ref",
                    "target_type_transform": "resolved-ref"
                },
                {
                    "input_parameter": "mask_type",
                    "target_property": "mask_type"
                },
                {
                    "input_parameter": "output_suffix",
                    "target_property": "output_suffix"
                },
                {
                    "input_parameter": "save_masked_assembly",
                    "target_property": "save_masked_assembly"
                },
                {
                    "input_parameter": "mask_scope",
                    "target_property": "mask_scope"
                },
                {
                    "input_parameter": "speed",
                    "target_property": "speed"
                },
                {
                    "input_parameter": "uncurated",
                    "target_property": "uncurated"
                },
                {
                    "input_parameter": "norna",
                    "target_property": "norna"
                },
                {
                    "input_parameter": "div",
                    "target_property": "div"
                },
                {
                    "input_parameter": "cutoff",
                    "target_property": "cutoff"
                },
                {
                    "input_parameter": "alignments",
                    "target_property": "alignments"
                }
            ],
            "output_mapping": [
                {
                    "service_method_output_path": [
                        0,
                        "report_name"
                    ],
                    "target_property": "report_name"
                },
                {
                    "service_method_output_path": [
                        0,
                        "report_ref"
                    ],
                    "target_property": "report_ref"
                },
                {
                    "narrative_system_variable": "workspace",
                    "target_property": "workspace_name"
                }
            ]
        }
    },
    "job_id_output_field": "docker"
}
